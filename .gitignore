# Build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
*.user

# Test / coverage
TestResults/
*.trx

# Rhino / Grasshopper build artifacts (Phase 3)
*.gha
*.rhp

# Yak packages (Phase 3 distribution)
*.yak
# The staged package folder (scripts of CI's "Stage the package" step, by hand): a local build output
dist/

# Native binaries are never committed. scripts/build_native.py builds them from the
# submodules (external/DualC, external/DualCEditor) into native/<rid>/ -- the C ABI
# library, DualC's dualc_field CLI and, on Windows, the GPU viewer and the editor with
# its Qt runtime -- and CI does the same. build-native-editor/ is the one CMake tree the
# script uses when the editor is on (the editor's CMake adds DualC as a subdirectory).
native/x64/
native/linux-x64/
build-native/
build-native-editor/

# Python bytecode from scripts/check.py
__pycache__/

# The dualc-links fixtures model a multi-config DualC build tree (build/examples/Release/);
# the [Rr]elease/ rule above must not drop it.
!scripts/check_fixtures/**/[Rr]elease/
